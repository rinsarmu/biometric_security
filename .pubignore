# NOTE: a .pubignore at the package root overrides the root .gitignore for
# publishing, so build/tooling exclusions must be repeated here.

# Build output & tooling
.dart_tool/
build/
coverage/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# IDE / project files
*.iml
.idea/

# Internal design, research, and audit documents. Kept in the source
# repository, but not part of the published package.
RESEARCH.md
ARCHITECTURE.md
API_DESIGN.md
STORAGE.md
SECURITY_AUDIT.md
USE_CASE_AUDIT.md
